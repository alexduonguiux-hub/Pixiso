{
  "name": "pixiso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"pnpm --filter @pixiso/web dev\" \"pnpm --filter @pixiso/server dev\"",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:render": "pnpm --filter @pixiso/web test:render",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:catalog": "tsx scripts/build-catalog.ts",
    "sheets": "tsx scripts/render-sheets.ts",
    "qa:hero": "tsx scripts/hero-qa.ts",
    "walk": "tsx scripts/hero-walk.ts",
    "qa:score": "tsx scripts/hero-score-dump.ts && python3 -I scripts/research/score.py",
    "qa:1x": "tsx scripts/hero-score-dump.ts && python3 -I scripts/research/qa_1x.py",
    "qa:pixel": "DUMP=test-output/view_figures.json tsx scripts/hero-views.ts > /dev/null && python3 -I scripts/research/pixel_lint.py test-output/view_figures.json -q && python3 -I scripts/research/pixel_lint.py packages/sprite-kit/src/hero64.poses.views.ts -q"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
